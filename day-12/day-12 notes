use this jenkins pipeline 

 
Final pipeline 

pipeline {
    agent any

    parameters {
        string(
            name: 'BRANCH',
            defaultValue: 'main',
            description: 'Git branch to build'
        )

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'staging', 'production'],
            description: 'Select deployment environment'
        )

        booleanParam(
            name: 'RUN_TESTS',
            defaultValue: true,
            description: 'Run application tests'
        )

        booleanParam(
            name: 'S_QUALITY_GATE_CHECK',
            defaultValue: true,
            description: 'Run application tests'
        )
    }

    environment {
        APP_NAME = 'cicd-demo'
        VERSION = "1.0.${BUILD_NUMBER}"
        DEPLOY_SERVER = 'your-server.example.com'
        VENV_DIR="${JENKINS_HOME}/venv/${APP_NAME}"
        SONAR_SCANNER_HOME = tool name: 'sonar-scanner', type: 'hudson.plugins.sonar.SonarRunnerInstallation'
        SNYK_TOKEN = credentials('snyk-id')
        IMAGENAME = "906353/${env.APP_NAME}:${env.VERSION}"


        // AWS ECR configuration
        AWS_REGION      = "ap-south-1"
        AWS_ACCOUNT_ID  = "928341811849"
        ECR_REGISTRY    = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REPOSITORY  = "cicd-demo"

    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        retry(2)
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Checking out branch: ${params.BRANCH}"
                git branch: "${params.BRANCH}", 
                    credentialsId: 'github-creds', 
                    url: 'https://github.com/rajendraprasad10/cicd-demo.git'
            }
        }

        stage('Build') {
            steps {
                echo "Building ${env.APP_NAME}"
                echo "Version: ${env.VERSION}"

                sh '''
                    echo "Starting build..."
                    python3 --version
                    
                    # Define venv directory (outside workspace)
                    # Use Jenkins home directory instead
                    
                    # Create directory if it doesn't exist
                    if [ ! -d "$VENV_DIR" ]; then
                        echo "Creating virtual environment at $VENV_DIR"
                        mkdir -p "$VENV_DIR"
                        python3 -m venv "$VENV_DIR"
                    else
                        echo "Virtual environment already exists at $VENV_DIR"
                    fi
                    
                    # Activate virtual environment
                    . "$VENV_DIR/bin/activate"
                    
                    # Upgrade pip, setuptools, and wheel
                    pip install --upgrade pip setuptools wheel
                    
                    # Install dependencies from requirements.txt
                    if [ -f "requirements.txt" ]; then
                        echo "Installing dependencies from requirements.txt"
                        pip install -r requirements.txt
                    else
                        echo "Warning: requirements.txt not found"
                    fi
                    
                    # Verify installation
                    pip list
                    
                    echo "Build completed successfully"
                '''
            }
        }


        stage('Test') {
            when {
                expression { return params.RUN_TESTS }
            }
            steps {
               
                sh '''
                    echo "Executing tests..."

                    # Activate virtual environment
                    . "$VENV_DIR/bin/activate"

                    # execute tests 
                    pytest tests --cov=app --cov-report=xml

                    echo "Tests completed successfully"
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarserver') {
                    sh '''
                        echo "Current directory:"

                        pwd

                        echo "Coverage report:"

                        ls -lh coverage.xml

                        echo "Running SonarQube Scanner..."

                        set -e

                        . "$VENV_DIR/bin/activate"

                        echo "Running SonarQube analysis..."

                        "$SONAR_SCANNER_HOME/bin/sonar-scanner"

                        echo "SonarQube analysis completed."
                        
                    '''
                }
            }
        }

        stage('Quality Gate') {
            when {
                expression { return params.S_QUALITY_GATE_CHECK }
            }

            steps {

                echo "========================================="
                echo "SONARQUBE QUALITY GATE"
                echo "========================================="

                timeout(
                    time: 5,
                    unit: 'MINUTES'
                ) {

                    script {

                        def qualityGate = waitForQualityGate(
                            abortPipeline: false
                        )

                        echo "SonarQube Quality Gate:"
                        echo "Status: ${qualityGate.status}"

                        if (qualityGate.status != 'OK') {

                            error(
                                "SonarQube Quality Gate failed: ${qualityGate.status}"
                            )
                        }

                        echo "Quality Gate PASSED."
                    }
                }
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh '''

                    trivy fs . 
 
                '''

                // trivy fs \
                //     --severity HIGH,CRITICAL \
                //     --exit-code 1 \
                //     .
            }
        }


        stage('Snyk Dependency Scan') {
            steps {
                sh '''

                    . "$VENV_DIR/bin/activate" 

                    snyk auth $SNYK_TOKEN

                    # Dependency scan (won't break pipeline)
                    snyk monitor --file=requirements.txt --project-name=cicd-demo-dependencies  --org=cicd-demo-dev  || true

                    # Code scan (won't break pipeline)
                    snyk code test --severity-threshold=high --report --project-name=cicd-demo-code  --org=cicd-demo-dev || true

                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t ${env.IMAGENAME} ."
            }
        }



        stage('Snyk Container Scan') {
            steps {
                sh """

                    . "$VENV_DIR/bin/activate" 

                    snyk auth $SNYK_TOKEN

                    snyk container monitor ${env.IMAGENAME}   --file=Dockerfile   --project-name=cicd-demo-container  --org=cicd-demo-dev || true

                """
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh """

                    trivy image \
                    --severity HIGH,CRITICAL \
                    ${env.IMAGENAME} 
 
                """
            }
        }

        stage('Push to AWS ECR') {
            steps {
                // Securely handle AWS authentication using your Jenkins credential ID
                withAWS(credentials: 'aws-cicd-demo-user-creds', region: "${AWS_REGION}") {
                    script {
                        echo "Logging into AWS ECR..."
                        sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"
                        
                        echo "Tagging image..."
                        sh "docker tag ${env.IMAGENAME} ${ECR_REGISTRY}/${ECR_REPOSITORY}:${env.VERSION}"
                        
                        echo "Pushing image..."
                        sh "docker push ${ECR_REGISTRY}/${ECR_REPOSITORY}:${env.VERSION}"
                    }
                }
            }
        }
    
       


        // stage('Approval') {
        //     when {
        //         expression { params.BRANCH == 'main' }
        //     }
        //     steps {
        //         input message: "Deploy to production?", ok: "Deploy"
        //     }
        // }
        
        stage('Deploy') {
            when {
                expression { params.BRANCH == 'main' }
            }
            steps {
                echo "Deploying ${env.APP_NAME}"
                echo "Environment: ${params.ENVIRONMENT}"

                sh '''
                    echo "Starting deployment..."
                    echo "Application: $APP_NAME"
                    echo "Version: $VERSION"
                    echo "Deployment completed successfully"
                '''
                
                sh """
                    chmod +x deploy.sh
                    ./deploy.sh ${params.ENVIRONMENT}
                    
                    """
            }
        }

    }

    post {
        always {
            script {
                echo "Cleaning up local build workspace images..."
                sh "docker logout ${ECR_REGISTRY} || true"
            }
            echo "Pipeline execution completed."
            cleanWs()
        }

        success {
            echo "SUCCESS: Application deployed successfully!"
            // echo "Environment: ${params.ENVIRONMENT}"
        }

        failure {
            echo "FAILURE: Pipeline failed. Please check the console logs."
        }

        unstable {
            echo "UNSTABLE: Pipeline completed, but there are test warnings/failures."
        }
    }
}



