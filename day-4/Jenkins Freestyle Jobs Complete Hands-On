	echo ""
	echo "Docker Containers:"
	docker ps
	
	Make it fail when disk usage is high
	USAGE=$(df / | awk 'NR==2 {print $5}' | tr -d '%')

	echo "Root filesystem usage: $USAGE%"

	if [ "$USAGE" -gt 80 ]; then
	    echo "ERROR: Disk usage is above 80%"
	    exit 1
	fi

	echo "Disk usage is healthy."


